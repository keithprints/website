# Copy this file to .env.local and fill in values from Supabase + Stripe dashboards.
# NEVER commit .env.local. The .gitignore already excludes it.

# ============ SUPABASE ============
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Service role key — NEVER expose to the browser. Only used by /api functions.
# Set this in Vercel env vars, not in .env.local that ships to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ============ STRIPE ============
# Get these from: Stripe Dashboard → Developers → API keys
# Use TEST keys (pk_test_..., sk_test_...) until you're ready to go live.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret. Get this AFTER creating the webhook endpoint in Stripe.
# Stripe Dashboard → Developers → Webhooks → click your endpoint → reveal signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ============ SITE ============
# The deployed URL of your site (used for Stripe success/cancel redirects)
# In local dev, this is http://localhost:5173
# In production, this is your Vercel URL or custom domain
SITE_URL=http://localhost:5173
